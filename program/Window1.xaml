<Window x:Class="program.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:program"
        mc:Ignorable="d"
        Title="Mobility Share Pro" Height="600" Width="900" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F6F7">
        <TabControl x:Name="MainTabs" TabStripPlacement="Left" BorderThickness="0,1,0,0">

            <TabItem Header="Anmelden" Height="70" Width="100" Margin="-2,-3,2,0" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                    <TextBlock Text="Willkommen" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Benutzername:"/>
                    <TextBox x:Name="UserLogin" Margin="0,5,0,15" Padding="5" TextChanged="UserLogin_TextChanged"/>
                    
                   
                    <Button Content="Login" Background="#2980B9" Foreground="White" Click="Login_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Fahrzeuge" Height="70" Width="100"  Margin="-2,-3,2,3">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Verfügbare Fahrzeuge" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <ListView x:Name="VehicleList" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=2}" SelectionChanged="VehicleList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Modell" DisplayMemberBinding="{Binding Modell}" Width="150"/>
                                <GridViewColumn Header="Typ" DisplayMemberBinding="{Binding Typ}" Width="100"/>
                                <GridViewColumn Header="Preis / Min" DisplayMemberBinding="{Binding Preis}" Width="100"/>
                                <GridViewColumn Header="Aktion">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Reservieren" Click="Reserve_Click" FontSize="10"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Aktuelle Miete" Height="70" Width="100" Margin="-2,-4,2,4">
                <Grid Margin="20">
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Background="White" Padding="30" VerticalAlignment="Top" HorizontalAlignment="Center" Width="400">
                        <StackPanel>
                            <TextBlock Text="Aktuelle Fahrt" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Separator Margin="0,0,0,15"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="Fahrzeug:"/>
                                <TextBlock x:Name="CurrentCarText" Text="Keines" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <TextBlock Text="Dauer:"/>
                                <TextBlock x:Name="DurationText" Text="00:00 Min" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <TextBlock Text="Kosten:" FontSize="16"/>
                                <TextBlock x:Name="CostText" Text="0.00 €" HorizontalAlignment="Right" Foreground="Green" FontWeight="Bold" FontSize="16"/>
                            </Grid>

                            <Button Content="Miete beenden &amp; Bezahlen" Margin="0,30,0,0" Background="#27AE60" Foreground="White" Click="Pay_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>